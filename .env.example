# Copia este archivo a .env y cambia los valores. .env no se versiona.

# --- Aplicación ---
# Cadena de conexión SQLAlchemy a PostgreSQL (driver psycopg 3). Dentro de compose el host es "db".
# Usuario, clave y base deben coincidir con las POSTGRES_* de abajo.
DATABASE_URL=postgresql+psycopg://notif:cambiar_clave@db:5432/notificaciones
# Nivel de log: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# --- Solo docker-compose ---
# Usuario, clave y base que crea el contenedor de PostgreSQL.
POSTGRES_USER=notif
POSTGRES_PASSWORD=cambiar_clave
POSTGRES_DB=notificaciones
# Puerto del host donde se publica la API (dentro del contenedor siempre es el 8000).
API_PORT=8000
